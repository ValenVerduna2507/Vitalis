@startuml casos-de-uso-vitalis
' ============================================================
'  Diagrama de Casos de Uso
'  Sistema de Gestion Integral - Vitalis Centro de Entrenamiento
'  Escuela Superior de Comercio N 49 "Justo Jose de Urquiza"
'  Grupo 02 - Desarrollo Web / Analista Funcional de Sistemas
'
'  Documentacion asociada: docs/casos-de-uso.md
'  Visualizar en: https://www.plantuml.com/plantuml/uml/
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 45

skinparam actor {
  BackgroundColor White
  BorderColor #1F3864
}
skinparam usecase {
  BackgroundColor #F2F5FA
  BorderColor #1F3864
  ArrowColor #1F3864
}
skinparam rectangle {
  BorderColor #1F3864
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #BDBDBD
}

title Diagrama de Casos de Uso\nSistema de Gestion Integral - Vitalis Centro de Entrenamiento

' ------------------------------------------------------------
'  ACTORES
' ------------------------------------------------------------
actor "Administrador\n(Propietaria / Directora)" as ADM
actor "Recepcionista" as REC
actor "Instructor" as INS
actor "Nutricionista" as NUT
actor "Alumno" as ALU
actor "Sistema de auditoria" as AUD

' ------------------------------------------------------------
'  LIMITE DEL SISTEMA
' ------------------------------------------------------------
rectangle "Sistema de Gestion Integral - Vitalis" {

  package "M7 - Seguridad, usuarios y roles" {
    usecase "CU-00\nAutenticar usuario" as CU00
    usecase "CU-16\nGestionar usuarios y roles" as CU16
  }

  package "M1 - Gestion de alumnos" {
    usecase "CU-01\nRegistrar alumno" as CU01
    usecase "CU-04\nModificar datos de alumno" as CU04
    usecase "CU-05\nDar de baja alumno" as CU05
    usecase "CU-06\nReactivar alumno" as CU06
  }

  package "M2 - Gestion de cuotas y pagos" {
    usecase "CU-02\nRegistrar pago de cuota" as CU02
    usecase "CU-03\nConsultar alumnos morosos" as CU03
    usecase "CU-07\nGestionar modalidades de cobro" as CU07
    usecase "Exportar reporte a PDF" as EXP
  }

  package "M3 - Planificacion de actividades" {
    usecase "CU-08\nGestionar disciplinas" as CU08
    usecase "CU-09\nCrear clase y asignar instructor" as CU09
    usecase "CU-10\nGestionar versiones de grilla" as CU10
    usecase "CU-11\nInscribir alumno a clase" as CU11
  }

  package "M4 - Control de asistencia" {
    usecase "CU-12\nRegistrar asistencia" as CU12
    usecase "Registrar asistente ocasional" as OCA
  }

  package "M5 - Seguimiento nutricional" {
    usecase "CU-13\nRegistrar consulta nutricional" as CU13
    usecase "CU-14\nConsultar evolucion del paciente" as CU14
  }

  package "M6 - Gestion de instructores" {
    usecase "CU-15\nGestionar instructores" as CU15
  }

  package "Consultas del alumno" {
    usecase "Consultar informacion propia" as CONS
  }
}

' ------------------------------------------------------------
'  ASOCIACIONES: ACTOR - CASO DE USO
' ------------------------------------------------------------

' Todos los actores se autentican
ADM --> CU00
REC --> CU00
INS --> CU00
NUT --> CU00
ALU --> CU00
ALU --> CONS

' Administrador (Propietaria / Directora)
ADM --> CU03
ADM --> CU07
ADM --> CU08
ADM --> CU09
ADM --> CU10
ADM --> CU15
ADM --> CU16

' Recepcionista
REC --> CU01
REC --> CU02
REC --> CU04
REC --> CU05
REC --> CU06
REC --> CU11

' Instructor
INS --> CU12

' Nutricionista
NUT --> CU13
NUT --> CU14

' Sistema de auditoria (actor secundario)
CU01 --> AUD
CU02 --> AUD

' ------------------------------------------------------------
'  RELACIONES <<include>>
'  El caso base SIEMPRE ejecuta el caso incluido.
'  La flecha va del caso base hacia el caso incluido.
' ------------------------------------------------------------
CU01 ..> CU00 : <<include>>
CU02 ..> CU00 : <<include>>
CU09 ..> CU00 : <<include>>
CU12 ..> CU00 : <<include>>
CU13 ..> CU00 : <<include>>

' ------------------------------------------------------------
'  RELACIONES <<extend>>
'  El caso extension se ejecuta SOLO bajo cierta condicion,
'  en un punto de extension del caso base.
'  La flecha va del caso extension hacia el caso base.
' ------------------------------------------------------------
CU06 ..> CU01 : <<extend>>\n(el DNI corresponde\na un alumno de baja)
EXP  ..> CU03 : <<extend>>\n(el usuario decide\nexportar el listado)
OCA  ..> CU12 : <<extend>>\n(se presenta un alumno\nno inscripto)

' ------------------------------------------------------------
'  NOTAS
' ------------------------------------------------------------
note right of CU00
  Incluido por todos los casos de uso
  del sistema. Por legibilidad, la
  relacion se dibuja solo sobre un
  caso representativo de cada modulo.
end note

legend right
  |= Relacion |= Significado |
  | Linea continua | Asociacion actor - caso de uso |
  | <<include>> | El caso base siempre ejecuta el incluido |
  | <<extend>> | El caso extension se ejecuta solo bajo condicion |
  Actores primarios: Administrador, Recepcionista,
  Instructor, Nutricionista, Alumno.
  Actor secundario: Sistema de auditoria (RNF05).

  CU-13 y CU-14: acceso exclusivo del rol
  Nutricionista al contenido clinico (RF21 / RN29).

  No existe <<extend>> entre CU-02 y CU-01: que el
  alumno este registrado es una PRECONDICION.
  Ver docs/casos-de-uso.md, seccion 3.4.
endlegend

@enduml
